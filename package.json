{
  "name": "basketball-franchise-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:data-sync": "node --test tools/data/player_data_pipeline.test.mjs",
    "data:sync-players": "node tools/data/sync_player_data.mjs",
    "data:sync-players:dry-run": "node tools/data/sync_player_data.mjs --dry-run",
    "data:sync-official-portraits": "node tools/data/sync_player_data.mjs --official-portraits-only",
    "data:build-portrait-atlas": "node tools/data/build_portrait_atlas.mjs",
    "headless:career": "tsx tools/headless/run-career.ts",
    "headless:expansion": "tsx tools/headless/run-expansion.ts",
    "headless:stage4": "tsx tools/headless/run-stage4.ts",
    "headless:manager-loop": "tsx tools/headless/run-stage4.ts --through-season2",
    "headless:lifecycle": "tsx tools/headless/run-lifecycle.ts",
    "headless:sim": "tsx tools/headless/run-seasons.ts",
    "headless:benchmark": "tsx tools/headless/benchmark.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
